PORT=8080
STORAGE_ROOT=./storage
FRONTEND_ORIGIN=http://localhost:5173

# Optional Gemini transcription and ranking
GEMINI_API_KEY=

# Cloudflare R2 S3 API
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=clipforge
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Recommended: custom domain or r2.dev public bucket URL.
# Leave empty to serve stable backend URLs that redirect to signed R2 GET URLs.
S3_PUBLIC_BASE_URL=

MAX_VIDEO_SIZE_MB=2048
